{
  "manifest_version": 3,
  "name": "New Tab Extension",
  "description": "An extension for about:newtab that brings life to the new tab.",
  "version": "1.0.0",
  "homepage_url": "https://github.com/OldValencia/NewTab",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },

  "permissions": [
    "storage",
    "bookmarks",
    "notifications",
    "tabs",
    "alarms"
  ],

  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "scripts/background-scripts/notifications.js"
  },
  "action": {
    "default_icon": {
      "96": "icons/icon-96.png"
    }
  },
  "icons": {
    "48": "icons/icon-48.svg",
    "96": "icons/icon-96.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/SFProDisplay-Regular.woff2",
        "fonts/SFProDisplay-Regular.woff",
        "fonts/SFProDisplay-Regular.ttf"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
